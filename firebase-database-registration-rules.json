{
  "rules": {
    ".read": false,
    ".write": false,

    "owner": {
      ".read": true,
      ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || data.child('uid').val() == auth.uid)"
    },

    "admins": {
      ".read": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('owner/uid').val() == auth.uid)",
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
      }
    },

    "students": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists() || (auth.uid == $uid && ((!data.exists() && newData.child('status').val() == 'pending') || (data.exists() && newData.child('status').val() == data.child('status').val()))))"
      }
    },

    "schools": {
      ".read": "auth != null",
      "$schoolId": {
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
      }
    },

    "groups": {
      ".read": "auth != null",
      "$groupId": {
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
      }
    },

    "subjects": {
      ".read": "auth != null",
      "$subjectId": {
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
      }
    },

    "grades": {
      ".read": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
      "$studentUid": {
        ".read": "auth != null && (auth.uid == $studentUid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "attendance": {
      ".read": "auth != null",
      "$groupId": {
        "$date": {
          "$studentUid": {
            ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('groups').child($groupId).child('adminIds').child(auth.uid).val() == true)"
          }
        }
      }
    },

    "notifications": {
      ".read": "auth != null",
      "$notificationId": {
        ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "notifRead": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}