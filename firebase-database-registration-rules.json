{
  "rules": {
    ".read": false,
    ".write": false,

    "owner": {
      ".read": true,
      ".write": "auth != null && ((!data.exists() && newData.child('uid').val() == auth.uid) || data.child('uid').val() == auth.uid)"
    },

    "admins": {
      ".read": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid)",
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid",
        "name": {
          ".write": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid)"
        },
        "phone": {
          ".write": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid)"
        }
      }
    },

    "students": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists() || (auth.uid == $uid && !data.exists() && newData.exists() && newData.child('status').val() == 'pending'))",
        "name": {
          ".write": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
        },
        "phone": {
          ".write": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
        }
      }
    },

    "schools": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
    },

    "groups": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
    },

    "subjects": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
    },

    "grades": {
      ".read": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
      }
    },

    "ownerAbout": {
      ".read": "auth != null && root.child('owner/uid').val() == auth.uid",
      ".write": "auth != null && root.child('owner/uid').val() == auth.uid"
    },

    "attendance": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
    },

    "notifications": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('owner/uid').val() == auth.uid || root.child('admins').child(auth.uid).exists())"
    },

    "notifRead": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        ".write": "auth != null && $uid == auth.uid"
      }
    }
  }
}