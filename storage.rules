rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'OWNER' && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.token.role == 'OWNER';
    }
  }
}
